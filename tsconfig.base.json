{
  "compilerOptions": {
    "baseUrl": "./",
    "module": "ES2022",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": "/dist/out-tsc",
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "declaration": true,
    "skipLibCheck": true,
    "stripInternal": true,
    "lib": [
      "ES2022",
      "dom"
    ],
    "paths": {
      "ngx-contextmenu": [
        "dist/ngx-contextmenu"
      ],
      "ngx-contextmenu/*": [
        "dist/ngx-contextmenu/*"
      ]
    }
  },
  "compileOnSave": false,
  "buildOnSave": false
}
