{
  "name": "ngx-contextmenu-platform",
  "version": "20.0.0",
  "description": "An Angular component to show a context menu on an arbitrary component",
  "keywords": [
    "angular2",
    "contextmenu",
    "angular2-contextmenu",
    "ngx-contextmenu",
    "ngx",
    "ng2",
    "ng2-contextmenu"
  ],
  "author": "Isaac Mann <isaacplmann@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/isaacplmann/ngx-contextmenu.git"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "jsnext:main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build:lib && npm run build:demo",
    "build:demo": "rimraf dist/demo && ng build ngx-contextmenu-demo",
    "build:lib": "ng build ngx-contextmenu --configuration production && copyfiles README.md LICENSE dist/ngx-contextmenu/",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "pub": "npm run pub:lib && npm run pub:demo",
    "pub:demo": "npm run build:demo -- --base-href /ngx-contextmenu/ && gh-pages -d dist/demo",
    "pub:lib": "npm run build:lib && npm publish dist/ngx-contextmenu",
    "pack:lib": "npm run build:lib && cd dist/ngx-contextmenu && npm pack && copyfiles *.tgz ../../ && cd ../.. && rimraf dist/ngx-contextmenu/*.tgz"
  },
  "browserslist": [
    "Chrome > 111"
  ],
  "private": false,
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.31",
    "@angular/cdk": "^20.2.14",
    "@angular/cli": "^21.2.31",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/compiler-cli": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@types/node": "^18.0.0",
    "@types/jasmine": "~4.0.3",
    "classlist.js": "^1.1.20150312",
    "codelyzer": "^6.0.0",
    "copyfiles": "^2.3.0",
    "gh-pages": "^3.1.0",
    "jasmine-core": "^5.0.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "~6.3.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-cli": "~2.0.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "ng-packagr": "^21.2.7",
    "protractor": "^7.0.0",
    "rimraf": "^3.0.2",
    "rxjs": "^7.0.0",
    "ts-node": "10.8.0",
    "tsickle": "^0.46.0",
    "tslib": "^2.0.0",
    "tslint": "~6.1.3",
    "typescript": "~5.9.3",
    "web-animations-js": "^2.3.2",
    "zone.js": "~0.15.0"
  },
  "dependencies": {
    "core-js": "^3.0.0"
  }
}
